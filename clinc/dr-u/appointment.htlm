<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <title>Book Appointment — Denta Care</title> <link rel="preconnect" href="https://fonts.googleapis.com" /> <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" /> <style>   :root {     --sky: #ddeeff; --sky-mid: #c8e3f8; --blue: #1a6fb5; --blue-dark: #134e82;     --orange: #f27430; --orange-dark: #d95e1a;     --text: #1a2340; --muted: #5a6a82; --radius: 18px;     --shadow: 0 8px 32px rgba(26,111,181,0.10);   }   * { margin: 0; padding: 0; box-sizing: border-box; }   body { font-family: 'DM Sans', sans-serif; background: var(--sky); color: var(--text); overflow-x: hidden; }   a { text-decoration: none; color: inherit; }    nav { position: sticky; top: 0; z-index: 100; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: space-between; padding: 0 5vw; height: 68px; box-shadow: 0 2px 16px rgba(26,111,181,0.07); }   .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--blue-dark); }   .nav-logo span { color: var(--orange); }   .nav-links { display: flex; gap: 2rem; align-items: center; }   .nav-links a { font-size: 0.92rem; font-weight: 500; color: var(--text); transition: color .2s; }   .nav-links a:hover { color: var(--orange); }   .nav-cta { background: var(--orange); color: #fff; padding: 0.55rem 1.3rem; border-radius: 50px; font-size: 0.88rem; font-weight: 600; transition: background .2s; }   .nav-cta:hover { background: var(--orange-dark); }   .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; }   .hamburger span { width: 24px; height: 2px; background: var(--text); border-radius: 2px; }   .mobile-menu { display: none; }    .page-banner {     background: linear-gradient(135deg, var(--orange), var(--orange-dark));     padding: 5rem 5vw 4rem; color: white; position: relative; overflow: hidden;   }   .page-banner::before { content: '📅'; position: absolute; right: 8%; top: 50%; transform: translateY(-50%); font-size: 8rem; opacity: 0.08; }   .breadcrumb { font-size: 0.82rem; opacity: 0.65; margin-bottom: 1rem; }   .page-banner h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 900; }   .page-banner p { margin-top: 1rem; opacity: 0.85; max-width: 540px; line-height: 1.7; }    /* LAYOUT */   .appt-layout { display: grid; grid-template-columns: 1fr 360px; gap: 2.5rem; padding: 4rem 5vw 5rem; align-items: start; }    /* FORM */   .form-card { background: white; border-radius: 24px; padding: 2.5rem; box-shadow: var(--shadow); }   .form-card h2 { font-family: 'Playfair Display', serif; font-size: 1.6rem; margin-bottom: 0.5rem; }   .form-card .form-sub { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }   .form-group { margin-bottom: 1.2rem; }   .form-group label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text); margin-bottom: 0.4rem; }   .form-group input,   .form-group select,   .form-group textarea {     width: 100%; padding: 0.75rem 1rem; border: 2px solid #e8f0f8;     border-radius: 12px; font-size: 0.92rem; font-family: 'DM Sans', sans-serif;     color: var(--text); background: #f8fbff; transition: border-color .2s;     outline: none;   }   .form-group input:focus,   .form-group select:focus,   .form-group textarea:focus { border-color: var(--blue); background: white; }   .form-group textarea { resize: vertical; min-height: 100px; }   .form-group .field-error { display: block; color: #e53e3e; font-size: 0.78rem; margin-top: 0.3rem; }   .form-group input.input-error,   .form-group select.input-error,   .form-group textarea.input-error { border-color: #e53e3e; }    .radio-group { display: flex; gap: 1.5rem; margin-top: 0.3rem; }   .radio-option { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.9rem; }   .radio-option input[type="radio"] { accent-color: var(--orange); width: 16px; height: 16px; }    .submit-btn {     width: 100%; background: var(--orange); color: white;     padding: 1rem; border: none; border-radius: 50px;     font-size: 1rem; font-weight: 700; cursor: pointer;     font-family: 'DM Sans', sans-serif; transition: all .2s; margin-top: 0.5rem;   }   .submit-btn:hover { background: var(--orange-dark); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(242,116,48,0.3); }   .form-note { font-size: 0.82rem; color: var(--muted); text-align: center; margin-top: 1rem; }    .success-box {     display: none; background: #ebfbf0; border: 2px solid #38a169;     border-radius: 12px; padding: 1rem 1.2rem; font-size: 0.92rem;     color: #276749; margin-bottom: 1.5rem; font-weight: 500;   }    /* SIDEBAR */   .sidebar { display: flex; flex-direction: column; gap: 1.5rem; }   .info-card { background: white; border-radius: 20px; padding: 1.8rem; box-shadow: var(--shadow); }   .info-card h3 { font-family: 'Playfair Display', serif; font-size: 1.1rem; margin-bottom: 1.2rem; color: var(--blue-dark); }   .info-item { display: flex; align-items: flex-start; gap: 0.8rem; margin-bottom: 1rem; }   .info-icon { font-size: 1.2rem; margin-top: 2px; flex-shrink: 0; }   .info-label { font-size: 0.78rem; color: var(--muted); }   .info-val { font-weight: 600; font-size: 0.92rem; color: var(--text); }   .doctor-mini { display: flex; align-items: center; gap: 1rem; padding: 1.2rem; background: var(--sky); border-radius: 14px; }   .doctor-mini-avatar { font-size: 2.5rem; width: 55px; height: 55px; background: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow); flex-shrink: 0; }   .doctor-mini-name { font-weight: 700; font-size: 0.95rem; }   .doctor-mini-title { font-size: 0.8rem; color: var(--muted); }   .hours-row { display: flex; justify-content: space-between; font-size: 0.87rem; padding: 0.5rem 0; border-bottom: 1px solid #f0f4f8; }   .hours-row:last-child { border-bottom: none; }   .hours-day { color: var(--muted); }   .hours-time { font-weight: 600; }    footer { background: var(--text); color: white; padding: 3rem 5vw 1.5rem; }   .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 3rem; padding-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }   .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.8rem; }   .footer-logo span { color: var(--orange); }   .footer-desc { font-size: 0.88rem; opacity: 0.65; line-height: 1.7; }   .footer-col h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; color: var(--sky); }   .footer-col a { display: block; font-size: 0.85rem; opacity: 0.65; margin-bottom: 0.6rem; }   .footer-bottom { text-align: center; padding-top: 1.5rem; font-size: 0.8rem; opacity: 0.45; }    @media (max-width: 900px) {     .appt-layout { grid-template-columns: 1fr; }     .sidebar { order: -1; }     .form-row { grid-template-columns: 1fr; }     .footer-top { grid-template-columns: 1fr; gap: 1.5rem; }     .nav-links { display: none; }     .hamburger { display: flex; }     .mobile-menu.open { display: flex; flex-direction: column; gap: 1rem; background: white; padding: 1.5rem 5vw; box-shadow: 0 8px 20px rgba(0,0,0,0.1); }     .mobile-menu a { font-size: 1rem; padding: 0.5rem 0; border-bottom: 1px solid #f0f4f8; }   } </style> </head> <body>  <nav>   <div class="nav-logo">Denta<span>Care</span></div>   <div class="nav-links">     <a href="index.html">Home</a>     <a href="about.html">About</a>     <a href="treatments.html">Treatments</a>     <a href="contact.html">Contact</a>     <a href="appointment.html" class="nav-cta" style="background:var(--blue);">Book Appointment</a>   </div>   <div class="hamburger" onclick="toggleMenu()">     <span></span><span></span><span></span>   </div> </nav> <div class="mobile-menu" id="mobileMenu">   <a href="index.html">Home</a>   <a href="about.html">About</a>   <a href="treatments.html">Treatments</a>   <a href="contact.html">Contact</a>   <a href="appointment.html" style="color:var(--orange);font-weight:700;">Book Appointment</a> </div>  <div class="page-banner">   <div class="breadcrumb">Home &rsaquo; Book Appointment</div>   <h1>Book Your Appointment</h1>   <p>Fill in the form below and our team at <span data-clinic="name"></span> will confirm your appointment within 24 hours.</p> </div>  <div class="appt-layout">    <!-- FORM -->   <div class="form-card">     <h2>Appointment Request</h2>     <p class="form-sub">All fields marked * are required. We'll contact you to confirm your slot.</p>      <form id="appointmentForm" novalidate>       <div class="success-box"></div>        <div class="form-row">         <div class="form-group">           <label>Full Name *</label>           <input type="text" name="fullname" placeholder="Your full name" required />         </div>         <div class="form-group">           <label>Phone Number *</label>           <input type="tel" name="phone" placeholder="10-digit mobile number" required />         </div>       </div>        <div class="form-row">         <div class="form-group">           <label>Email Address *</label>           <input type="email" name="email" placeholder="you@example.com" required />         </div>         <div class="form-group">           <label>Age *</label>           <input type="number" name="age" placeholder="Your age" min="1" max="120" required />         </div>       </div>        <div class="form-row">         <div class="form-group">           <label>Preferred Date *</label>           <input type="date" name="date" required />         </div>         <div class="form-group">           <label>Preferred Time *</label>           <select name="time" required>             <option value="">Select a time slot</option>             <option>10:00 AM – 11:00 AM</option>             <option>11:00 AM – 12:00 PM</option>             <option>12:00 PM – 1:00 PM</option>             <option>2:00 PM – 3:00 PM</option>             <option>3:00 PM – 4:00 PM</option>             <option>4:00 PM – 5:00 PM</option>             <option>5:00 PM – 6:00 PM</option>             <option>6:00 PM – 7:00 PM</option>           </select>         </div>       </div>        <div class="form-row">         <div class="form-group">           <label>Gender *</label>           <select name="gender" required>             <option value="">Select gender</option>             <option>Male</option>             <option>Female</option>             <option>Other</option>             <option>Prefer not to say</option>           </select>         </div>         <div class="form-group">           <label>Treatment Needed *</label>           <select name="treatment" required>             <option value="">Select treatment</option>             <option>Teeth Cleaning</option>             <option>Braces / Teeth Alignment</option>             <option>Root Canal Treatment</option>             <option>Tooth Extraction</option>             <option>Dental Implants</option>             <option>Dentures</option>             <option>General Checkup / Consultation</option>             <option>Other</option>           </select>         </div>       </div>        <div class="form-group">         <label>Patient Type *</label>         <div class="radio-group">           <label class="radio-option"><input type="radio" name="patientType" value="New" required /> New Patient</label>           <label class="radio-option"><input type="radio" name="patientType" value="Existing" /> Existing Patient</label>         </div>       </div>        <div class="form-group">         <label>Message / Problem Description</label>         <textarea name="message" placeholder="Briefly describe your dental concern or any special requirements..."></textarea>       </div>        <button type="submit" class="submit-btn">Confirm Appointment Request →</button>       <p class="form-note">📞 We will call you to confirm your appointment within 24 hours.</p>     </form>   </div>    <!-- SIDEBAR -->   <div class="sidebar">     <div class="info-card">       <div class="doctor-mini">         <div class="doctor-mini-avatar">👨‍⚕️</div>         <div>           <div class="doctor-mini-name" data-clinic="doctor"></div>           <div class="doctor-mini-title">Dental Specialist</div>         </div>       </div>     </div>      <div class="info-card">       <h3>Clinic Information</h3>       <div class="info-item">         <div class="info-icon">📍</div>         <div>           <div class="info-label">Address</div>           <div class="info-val" data-clinic="address"></div>         </div>       </div>       <div class="info-item">         <div class="info-icon">📞</div>         <div>           <div class="info-label">Phone</div>           <div class="info-val" data-clinic="phone"></div>         </div>       </div>       <div class="info-item">         <div class="info-icon">✉️</div>         <div>           <div class="info-label">Email</div>           <div class="info-val" data-clinic="email"></div>         </div>       </div>     </div>      <div class="info-card">       <h3>Clinic Hours</h3>       <div class="hours-row">         <span class="hours-day">Mon – Sat</span>         <span class="hours-time" data-clinic="hours"></span>       </div>       <div class="hours-row">         <span class="hours-day">Sunday</span>         <span class="hours-time">Closed</span>       </div>     </div>   </div>  </div>  <footer>   <div class="footer-top">     <div>       <div class="footer-logo">Denta<span>Care</span></div>       <p class="footer-desc">Premium dental care in <span data-clinic="location"></span>. Committed to your health, comfort, and a beautiful smile.</p>     </div>     <div class="footer-col">       <h4>Quick Links</h4>       <a href="index.html">Home</a>       <a href="about.html">About Us</a>       <a href="treatments.html">Treatments</a>       <a href="appointment.html">Book Appointment</a>       <a href="contact.html">Contact</a>     </div>     <div class="footer-col">       <h4>Contact</h4>       <a href="#" data-clinic="phone"></a>       <a href="#" data-clinic="email"></a>       <a href="#" data-clinic="address"></a>     </div>   </div>   <div class="footer-bottom">© 2025 <span data-clinic="name"></span>. All rights reserved. 
 Dr. <span data-clinic="doctor"></span></div> </footer>  <script src="config.js"></script> <script src="form.js"></script> <script> function toggleMenu(){document.getElementById('mobileMenu').classList.toggle('open');} // Set min date to today const dateInput = document.querySelector('[name="date"]'); if (dateInput) {   const today = new Date().toISOString().split('T')[0];   dateInput.setAttribute('min', today); } </script> </body> </html>
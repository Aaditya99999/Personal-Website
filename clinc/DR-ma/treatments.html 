form .25s, box-shadow .25s;     display: flex; flex-direction: column;   }   .t-card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(26,111,181,0.15); }   .t-card-header {     padding: 2.5rem 2rem 1.5rem;     display: flex; align-items: flex-start; gap: 1.2rem;   }   .t-icon-wrap { width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; flex-shrink: 0; }   .ic-blue { background: var(--sky); }   .ic-orange { background: #fff3ec; }   .ic-green { background: #eafaf1; }   .t-card-title { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; margin-bottom: 0.2rem; }   .t-card-tag { font-size: 0.78rem; color: var(--orange); font-weight: 600; }   .t-card-body { padding: 0 2rem 1.5rem; flex: 1; }   .t-card-body p { color: var(--muted); font-size: 0.9rem; line-height: 1.75; }   .t-card-footer { padding: 1rem 2rem 2rem; }   .btn-book { background: var(--orange); color: white; padding: 0.65rem 1.5rem; border-radius: 50px; font-size: 0.88rem; font-weight: 600; display: inline-block; transition: all .2s; }   .btn-book:hover { background: var(--orange-dark); transform: translateY(-1px); }    /* CTA SECTION */   .cta-section {     background: linear-gradient(135deg, var(--blue-dark), var(--blue));     margin: 0 5vw 5rem; border-radius: 24px; padding: 4rem;     text-align: center; color: white;   }   .cta-section h2 { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1rem; }   .cta-section p { opacity: 0.8; margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.7; }   .btn-orange-big { background: var(--orange); color: white; padding: 0.9rem 2.5rem; border-radius: 50px; font-size: 1rem; font-weight: 700; display: inline-block; transition: all .2s; }   .btn-orange-big:hover { background: var(--orange-dark); transform: translateY(-2px); box-shadow: 0 10px 30px rgba(242,116,48,0.4); }    footer { background: var(--text); color: white; padding: 3rem 5vw 1.5rem; }   .footer-top { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 3rem; padding-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }   .footer-logo { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 700; margin-bottom: 0.8rem; }   .footer-logo span { color: var(--orange); }   .footer-desc { font-size: 0.88rem; opacity: 0.65; line-height: 1.7; }   .footer-col h4 { font-size: 0.9rem; font-weight: 600; margin-bottom: 1rem; color: var(--sky); }   .footer-col a { display: block; font-size: 0.85rem; opacity: 0.65; margin-bottom: 0.6rem; }   .footer-bottom { text-align: center; padding-top: 1.5rem; font-size: 0.8rem; opacity: 0.45; }    @media (max-width: 900px) {     .why-timely { grid-template-columns: 1fr 1fr; margin: 0 3vw 2rem; }     .footer-top { grid-template-columns: 1fr; gap: 1.5rem; }     .nav-links { display: none; }     .hamburger { display: flex; }     .mobile-menu.open { display: flex; flex-direction: column; gap: 1rem; background: white; padding: 1.5rem 5vw; box-shadow: 0 8px 20px rgba(0,0,0,0.1); }     .mobile-menu a { font-size: 1rem; padding: 0.5rem 0; border-bottom: 1px solid #f0f4f8; }   }   @media (max-width: 500px) {     .why-timely { grid-template-columns: 1fr; }     .cta-section { margin: 0 3vw 3rem; padding: 2.5rem 1.5rem; }   } </style> </head> <body>  <nav>   <div class="nav-logo">Denta<span>Care</span></div>   <div class="nav-links">     <a href="index.html">Home</a>     <a href="about.html">About</a>     <a href="treatments.html" style="color:var(--orange);">Treatments</a>     <a href="contact.html">Contact</a>     <a href="appointment.html" class="nav-cta">Book Appointment</a>   </div>   <div class="hamburger" onclick="toggleMenu()">     <span></span><span></span><span></span>   </div> </nav> <div class="mobile-menu" id="mobileMenu">   <a href="index.html">Home</a>   <a href="about.html">About</a>   <a href="treatments.html">Treatments</a>   <a href="contact.html">Contact</a>   <a href="appointment.html" style="color:var(--orange);font-weight:700;">Book Appointment</a> </div>  <div class="page-banner">   <div class="breadcrumb">Home &rsaquo; Treatments</div>   <h1>Our <span>Treatments</span></h1>   <p>Comprehensive dental services tailored to your needs — delivered with precision, care, and comfort at <span data-clinic="name"></span>.</p> </div>  <!-- INTRO --> <div class="intro">   <h2>Modern Dentistry, Gentle Touch</h2>   <p>At <strong data-clinic="name"></strong>, we offer a full range of dental treatments under one roof. Whether it's a routine check-up or a complex procedure, our expert doctor ensures you receive the best possible care with the latest techniques.</p> </div>  <!-- WHY TIMELY --> <div class="why-timely">   <div class="timely-item">     <div class="timely-icon">⚡</div>     <div class="timely-title">Early Detection Saves Teeth</div>     <div class="timely-desc">Catching dental issues early prevents costly and painful treatments later.</div>   </div>   <div class="timely-item">     <div class="timely-icon">💪</div>     <div class="timely-title">Better Overall Health</div>     <div class="timely-desc">Oral health directly impacts heart health, immunity, and overall wellbeing.</div>   </div>   <div class="timely-item">     <div class="timely-icon">😊</div>     <div class="timely-title">Confidence in Every Smile</div>     <div class="timely-desc">Timely treatment keeps your smile beautiful, fresh, and confident.</div>   </div>   <div class="timely-item">     <div class="timely-icon">💸</div>     <div class="timely-title">Save Money Long-Term</div>     <div class="timely-desc">Prevention and early care cost far less than emergency procedures.</div>   </div> </div>  <!-- TREATMENTS --> <div class="treatments-section">   <div class="section-tag">All Treatments</div>   <div class="section-title">What We Offer at <span data-clinic="name"></span></div>   <div class="treatments-grid">      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-blue">🦷</div>         <div>           <div class="t-card-title">Teeth Cleaning</div>           <div class="t-card-tag">Preventive Care</div>         </div>       </div>       <div class="t-card-body">         <p>Professional scaling and polishing remove plaque, tartar, and surface stains that regular brushing can't. Our thorough cleaning sessions protect your gums, freshen your breath, and keep your teeth healthy long-term. Recommended every 6 months.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-orange">😬</div>         <div>           <div class="t-card-title">Braces & Teeth Alignment</div>           <div class="t-card-tag">Orthodontics</div>         </div>       </div>       <div class="t-card-body">         <p>Crooked or misaligned teeth affect both confidence and bite function. We offer modern metal and ceramic braces carefully fitted to straighten your teeth effectively. Our doctor designs a personalized treatment plan for optimal, lasting results.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-blue">💉</div>         <div>           <div class="t-card-title">Root Canal Treatment</div>           <div class="t-card-tag">Restorative</div>         </div>       </div>       <div class="t-card-body">         <p>A root canal saves your natural tooth when the pulp is infected or damaged. Using precision instruments and anesthesia, the procedure is virtually painless. We clean, seal, and restore the tooth so you can keep it for years to come.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-orange">🔧</div>         <div>           <div class="t-card-title">Tooth Extraction</div>           <div class="t-card-tag">Oral Surgery</div>         </div>       </div>       <div class="t-card-body">         <p>When a tooth is severely damaged, decayed, or causing crowding, a gentle extraction is the safest solution. Our doctor ensures a comfortable, anxiety-free experience with proper aftercare instructions to promote fast healing.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-green">🔩</div>         <div>           <div class="t-card-title">Dental Implants</div>           <div class="t-card-tag">Permanent Restoration</div>         </div>       </div>       <div class="t-card-body">         <p>Missing a tooth? Dental implants are the gold standard replacement — a titanium post fused with your jawbone, topped with a natural-looking crown. They look, feel, and function exactly like real teeth, restoring your smile and confidence permanently.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>      <div class="t-card">       <div class="t-card-header">         <div class="t-icon-wrap ic-blue">👄</div>         <div>           <div class="t-card-title">Dentures</div>           <div class="t-card-tag">Prosthetic Dentistry</div>         </div>       </div>       <div class="t-card-body">         <p>Comfortable, custom-fitted dentures for patients who have lost multiple or all teeth. Whether full or partial dentures, we craft them to fit perfectly, restoring your ability to eat, speak, and smile naturally. Affordable and long-lasting solutions.</p>       </div>       <div class="t-card-footer"><a href="appointment.html" class="btn-book">Book Now →</a></div>     </div>    </div> </div>  <!-- CTA --> <div class="cta-section">   <h2>Not Sure Which Treatment You Need?</h2>   <p>Book a consultation with <span data-clinic="doctor"></span> at <span data-clinic="name"></span> today. We'll assess your dental health and recommend the best treatment plan for you.</p>   <a href="appointment.html" class="btn-orange-big">Book a Free Consultation →</a> </div>  <footer>   <div class="footer-top">     <div>       <div class="footer-logo">Denta<span>Care</span></div>       <p class="footer-desc">Premium dental care in <span data-clinic="location"></span>. Committed to your health, comfort, and a beautiful smile.</p>     </div>     <div class="footer-col">       <h4>Quick Links</h4>       <a href="index.html">Home</a>       <a href="about.html">About Us</a>       <a href="treatments.html">Treatments</a>       <a href="appointment.html">Book Appointment</a>       <a href="contact.html">Contact</a>     </div>     <div class="footer-col">       <h4>Contact</h4>       <a href="#" data-clinic="phone"></a>       <a href="#" data-clinic="email"></a>       <a href="#" data-clinic="address"></a>     </div>   </div>   <div class="footer-bottom">© 2025 <span data-clinic="name"></span>. All rights reserved. 
